---
import About from '../components/About.astro';
import Clients from '../components/Clients.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PensionOffers from '../components/PensionOffers.astro';
import ServiceShowcase from '../components/ServiceShowcase.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex,nofollow" />
		<meta name="description" content="Despacho líder en México, especializado en materia de Seguridad Social. Asesoría experta y estratégica para planear tu retiro, maximizar tu pensión y recuperar fondos de AFORE." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Estenio Corporativo</title>
	</head>
	<body>
		<Header />
		<main>
			<Hero />
			<ServiceShowcase />
			<PensionOffers />
			<About />
			<Clients />
			<Contact />
		</main>
		<Footer />
	</body>
</html>
