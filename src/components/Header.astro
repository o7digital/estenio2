---
import { navItems, serviceNavItems } from '../content/estenio';
---

<header class="site-header">
  <nav class="nav wrap" aria-label="Navegación principal">
    <a class="brand" href="#inicio" aria-label="Estenio Corporativo, inicio"><img src="/assets/original/logo-header.png" alt="Estenio corporativo" width="145" height="65" /></a>
    <div class="links" id="navlinks">
      {navItems.slice(0, 2).map((item) => <a href={item.href}>{item.label}</a>)}
      <details class="nav-group">
        <summary>SERVICIOS EMPRESARIALES</summary>
        <div class="nav-submenu">
          {serviceNavItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
      {navItems.slice(2).map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <button class="menu" type="button" aria-label="Abrir menú" aria-controls="navlinks" aria-expanded="false">☰</button>
  </nav>
</header>

<script>
  const header = document.querySelector('.site-header');
  const menu = document.querySelector('.menu');
  const nav = document.querySelector('.links');

  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  if (menu && nav) {
    const closeMenu = () => {
      nav.classList.remove('open');
      menu.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-label', 'Abrir menú');
    };

    menu.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      menu.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    });
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    nav.querySelectorAll('summary').forEach((summary) => summary.addEventListener('click', (event) => {
      if (window.innerWidth <= 700) event.stopPropagation();
    }));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu();
        nav.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((details) => { details.open = false; });
      }
    });
  }
</script>
